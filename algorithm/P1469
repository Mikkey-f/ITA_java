#include<bits/stdc++.h> 
using namespace std;
int n,b[10000005];
map<int,int>a;
int main(){
	cin>>n;
	for(int i=1;i<=n;i++){
		cin>>b[i];
		a[b[i]]++;//记录该长度出现的次数
	}
	for(int i=1;i<=n;i++){
		if(a[b[i]]%2==1){//如果是奇数，说明为多余的筷子
			cout<<b[i];
			break;
		}
	}
	return 0;
} 
 
