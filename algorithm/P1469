#include<bits/stdc++.h> 
using namespace std;
int n,ans;
int main(){
	scanf("%d",&n);
	for(int i=1;i<=n;i++){
		int a;
		scanf("%d",&a);
		ans^=a;
		//在将所有筷子长度依次异或的过程中，成对的筷子长度异或后都得到0，
		//而最后剩下的就是那只落单筷子的长度。
	}
	printf("%d",ans); 
	return 0;
} 
